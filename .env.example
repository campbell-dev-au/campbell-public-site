# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed.

# The Gmail account sending the contact-form emails.
GMAIL_USER=campbell.davis90@gmail.com

# A Gmail App Password for GMAIL_USER (requires 2-Step Verification):
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Where contact-form submissions are delivered. Supports plus-addressing
# to keep them out of the main inbox. Falls back to GMAIL_USER if unset.
CONTACT_TO_EMAIL=campbell.davis90+site@gmail.com
