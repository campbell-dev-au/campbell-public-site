# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed.

# The mailbox sending the contact-form emails (Porkbun-hosted mail for
# campbelldavis.com.au). Get the exact host/port from Porkbun's mailbox
# settings page.
SMTP_HOST=smtp.porkbun.com
SMTP_PORT=465
SMTP_USER=hello@campbelldavis.com.au
SMTP_PASSWORD=

# Where contact-form submissions are delivered. Optional — falls back to
# SMTP_USER if unset.
CONTACT_TO_EMAIL=
